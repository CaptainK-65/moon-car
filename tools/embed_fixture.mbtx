import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/io",
  "moonbitlang/core/buffer",
}

///|
async fn main {
  let bytes = @fs.read_file("fixtures/carv1-basic.car").binary()
  let buffer = @buffer.Buffer()
  buffer.write_string_utf8("// Generated by tools/embed_fixture.mbtx; fixture provenance: fixtures/README.md\n///|\nlet official_fixture : Bytes = b\"")
  let hex = b"0123456789abcdef"
  for byte in bytes {
    buffer.write_bytes(b"\\x")
    buffer.write_byte(hex[byte.to_int() >> 4])
    buffer.write_byte(hex[byte.to_int() & 15])
  }
  buffer.write_string_utf8("\"\n")
  @fs.write_file("fixture_bytes_test.mbt", buffer.to_bytes())
  println("embedded \{bytes.length()} fixture bytes")
}
